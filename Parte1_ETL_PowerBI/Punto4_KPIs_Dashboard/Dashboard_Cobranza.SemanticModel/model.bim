      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "Medida",
            "dataType": "string",
            "isHidden": true,
            "type": "calculatedTableColumn",
            "sourceColumn": "[Medida]"
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW(\"Medida\", BLANK())"
            }
          }
        ],
        "measures": [
          {
            "name": "Gestiones (todas las fuentes)",
            "expression": "COUNTROWS(fact_gestiones)",
            "formatString": "#,0",
            "displayFolder": "1. Gestión",
            "description": "Gestiones de cobranza (jun–ago 2025) + SMS del Reporte1 (jul-2022). Solo para ver el volumen por canal."
          },
          {
            "name": "Gestiones de cobranza",
            "expression": "CALCULATE(COUNTROWS(fact_gestiones), fact_gestiones[fuente] = \"Gestiones\")",
            "formatString": "#,0",
            "displayFolder": "1. Gestión",
            "description": "Gestiones de cobranza de la Base 4 (sin SMS)."
          },
          {
            "name": "Créditos con gestión de cobranza",
            "expression": "CALCULATE(DISTINCTCOUNT(fact_gestiones[credito_id]), fact_gestiones[fuente] = \"Gestiones\")",
            "formatString": "#,0",
            "displayFolder": "1. Gestión",
            "description": "Créditos distintos con al menos una gestión de cobranza."
          },
          {
            "name": "Intensidad de gestión",
            "expression": "DIVIDE([Gestiones de cobranza], [Créditos con gestión de cobranza])",
            "formatString": "#,0.0",
            "displayFolder": "1. Gestión",
            "description": "Gestiones de cobranza promedio por crédito gestionado."
          },
          {
            "name": "Créditos en cartera",
            "expression": "DISTINCTCOUNT(dim_credito[credito_id])",
            "formatString": "#,0",
            "displayFolder": "1. Gestión",
            "description": "Créditos del portafolio (Comité)."
          },
          {
            "name": "Cobertura de cartera",
            "expression": "DIVIDE([Créditos con gestión de cobranza], [Créditos en cartera])",
            "formatString": "0.0%",
            "displayFolder": "1. Gestión",
            "description": "% de la cartera que recibió al menos una gestión de cobranza."
          },
          {
            "name": "Cobertura cartera en mora",
            "expression": "DIVIDE(CALCULATE([Créditos con gestión de cobranza], dim_credito[dias_mora] > 0), CALCULATE([Créditos en cartera], dim_credito[dias_mora] > 0))",
            "formatString": "0.0%",
            "displayFolder": "1. Gestión",
            "description": "% de los créditos en mora que recibieron gestión de cobranza."
          },
          {
            "name": "Intentos de contacto",
            "expression": "CALCULATE(COUNTROWS(fact_gestiones), fact_gestiones[es_intento_contacto] = TRUE())",
            "formatString": "#,0",
            "displayFolder": "2. Contacto",
            "description": "Gestiones telefónicas (denominador de contactabilidad)."
          },
          {
            "name": "Contactos",
            "expression": "CALCULATE(COUNTROWS(fact_gestiones), fact_gestiones[es_contacto] = TRUE())",
            "formatString": "#,0",
            "displayFolder": "2. Contacto",
            "description": "Intentos en los que se habló con alguien (titular o tercero)."
          },
          {
            "name": "Contactos directos",
            "expression": "CALCULATE(COUNTROWS(fact_gestiones), fact_gestiones[es_contacto_directo] = TRUE())",
            "formatString": "#,0",
            "displayFolder": "2. Contacto",
            "description": "Intentos en los que se habló con el titular."
          },
          {
            "name": "Tasa de contactabilidad",
            "expression": "DIVIDE([Contactos], [Intentos de contacto])",
            "formatString": "0.0%",
            "displayFolder": "2. Contacto",
            "description": "Contactos / intentos de contacto."
          },
          {
            "name": "Tasa de contacto directo",
            "expression": "DIVIDE([Contactos directos], [Intentos de contacto])",
            "formatString": "0.0%",
            "displayFolder": "2. Contacto",
            "description": "Contactos con el titular / intentos de contacto."
          },
          {
            "name": "Promesas generadas",
            "expression": "CALCULATE(COUNTROWS(fact_gestiones), fact_gestiones[es_promesa] = TRUE())",
            "formatString": "#,0",
            "displayFolder": "3. Promesas",
            "description": "Gestiones que terminaron en promesa de pago (por fecha de gestión)."
          },
          {
            "name": "Tasa PTP",
            "expression": "DIVIDE([Promesas generadas], [Contactos directos])",
            "formatString": "0.0%",
            "displayFolder": "3. Promesas",
            "description": "Promise to Pay: promesas / contactos directos."
          },
          {
            "name": "Promesas",
            "expression": "COUNTROWS(fact_promesas)",
            "formatString": "#,0",
            "displayFolder": "3. Promesas",
            "description": "Promesas (por fecha prometida)."
          },
          {
            "name": "Promesas vencidas",
            "expression": "CALCULATE([Promesas], fact_promesas[es_vencida] = TRUE())",
            "formatString": "#,0",
            "displayFolder": "3. Promesas",
            "description": "Promesas cuya fecha límite ya pasó a la fecha de corte."
          },
          {
            "name": "Promesas cumplidas",
            "expression": "CALCULATE([Promesas], fact_promesas[es_vencida] = TRUE(), fact_promesas[es_cumplida] = TRUE())",
            "formatString": "#,0",
            "displayFolder": "3. Promesas",
            "description": "Promesas vencidas con pago efectivo >= 90 % de lo prometido."
          },
          {
            "name": "Promesas incumplidas",
            "expression": "[Promesas vencidas] - [Promesas cumplidas]",
            "formatString": "#,0",
            "displayFolder": "3. Promesas",
            "description": "Promesas vencidas sin pago suficiente."
          },
          {
            "name": "Kept rate",
            "expression": "DIVIDE([Promesas cumplidas], [Promesas vencidas])",
            "formatString": "0.0%",
            "displayFolder": "3. Promesas",
            "description": "% de promesas vencidas que se cumplieron."
          },
          {
            "name": "Valor prometido",
            "expression": "SUM(fact_promesas[valor_promesa])",
            "formatString": "$#,0",
            "displayFolder": "3. Promesas",
            "description": "Monto total prometido."
          },
          {
            "name": "Valor pagado sobre promesas",
            "expression": "SUM(fact_promesas[valor_pagado])",
            "formatString": "$#,0",
            "displayFolder": "3. Promesas",
            "description": "Recaudo efectivo recibido dentro de la ventana de cada promesa."
          },
          {
            "name": "Recaudo efectivo",
            "expression": "CALCULATE(SUM(fact_recaudo[valor_total_pago]), fact_recaudo[es_recaudo_efectivo] = TRUE())",
            "formatString": "$#,0",
            "displayFolder": "4. Recaudo",
            "description": "Pagos efectivos netos de reversiones (excluye Ajuste / Otros / Otros sin información)."
          },
          {
            "name": "Recaudo con gestión previa",
            "expression": "CALCULATE([Recaudo efectivo], fact_recaudo[tuvo_gestion_previa_30d] = TRUE())",
            "formatString": "$#,0",
            "displayFolder": "4. Recaudo",
            "description": "Recaudo de créditos gestionados en los 30 días previos al pago."
          },
          {
            "name": "% recaudo con gestión previa",
            "expression": "DIVIDE([Recaudo con gestión previa], [Recaudo efectivo])",
            "formatString": "0.0%",
            "displayFolder": "4. Recaudo",
            "description": "Participación del recaudo asociada a la gestión."
          },
          {
            "name": "Reversiones",
            "expression": "CALCULATE(SUM(fact_recaudo[valor_total_pago]), fact_recaudo[es_reversion] = TRUE())",
            "formatString": "$#,0",
            "displayFolder": "4. Recaudo",
            "description": "Valor reversado (negativo)."
          },
          {
            "name": "Saldo de cartera",
            "expression": "SUM(fact_cartera_mes[saldo_capital])",
            "formatString": "$#,0",
            "displayFolder": "5. Cartera",
            "description": "Saldo de capital (Comité)."
          },
          {
            "name": "Saldo en mora +30",
            "expression": "CALCULATE([Saldo de cartera], fact_cartera_mes[dias_mora] > 30)",
            "formatString": "$#,0",
            "displayFolder": "5. Cartera",
            "description": "Saldo de créditos con más de 30 días de mora."
          },
          {
            "name": "Índice de cartera vencida",
            "expression": "DIVIDE([Saldo en mora +30], [Saldo de cartera])",
            "formatString": "0.0%",
            "displayFolder": "5. Cartera",
            "description": "ICV: saldo en mora +30 / saldo total."
          },
          {
            "name": "SMS enviados",
            "expression": "CALCULATE(COUNTROWS(fact_gestiones), fact_gestiones[canal] = \"SMS\")",
            "formatString": "#,0",
            "displayFolder": "6. SMS",
            "description": "Mensajes del Reporte1."
          },
          {
            "name": "Créditos con SMS",
            "expression": "CALCULATE(DISTINCTCOUNT(fact_gestiones[credito_id]), fact_gestiones[canal] = \"SMS\")",
            "formatString": "#,0",
            "displayFolder": "6. SMS",
            "description": "Créditos distintos contactados por SMS."
          },
          {
            "name": "Tasa de entrega SMS",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(fact_gestiones), fact_gestiones[canal] = \"SMS\", fact_gestiones[es_entregado] = TRUE()), [SMS enviados])",
            "formatString": "0.0%",
            "displayFolder": "6. SMS",
            "description": "SMS entregados a la red / enviados."
          },
          {
            "name": "CTR SMS",
            "expression": "DIVIDE(CALCULATE(SUM(fact_gestiones[total_clics]), fact_gestiones[canal] = \"SMS\"), [SMS enviados])",
            "formatString": "0.00%",
            "displayFolder": "6. SMS",
            "description": "Clics / SMS enviados."
          },
          {
            "name": "SMS por crédito",
            "expression": "DIVIDE([SMS enviados], [Créditos con SMS])",
            "formatString": "#,0.0",
            "displayFolder": "6. SMS",
            "description": "Intensidad del canal SMS."
          },
          {
            "name": "IA generado",
            "expression": "IF(ISEMPTY(resumen_ia), \"Sin resumen: ejecute python -m Punto_Opcional_IA.resumen_ia\", \"Generado por \" & MAX(resumen_ia[modelo]) & \" el \" & FORMAT(MAX(resumen_ia[generado_en]), \"dd/mm/yyyy hh:nn\") & \" · corte \" & FORMAT(MAX(resumen_ia[fecha_corte]), \"dd/mm/yyyy\"))",
            "formatString": "",
            "displayFolder": "7. Resumen IA",
            "description": "Modelo y fecha del último resumen generado con IA."
          },
          {
            "name": "Filas Vista 1",
            "expression": "COUNTROWS(vw_promesas_incumplidas_3d)",
            "formatString": "#,0",
            "displayFolder": "8. Seguimiento de promesas",
            "description": "Promesas incumplidas de los últimos 3 días (una fila por crédito y día prometido)."
          },
          {
            "name": "Créditos Vista 2",
            "expression": "COUNTROWS(vw_mora60_incumplidas_hoy)",
            "formatString": "#,0",
            "displayFolder": "8. Seguimiento de promesas",
            "description": "Créditos con más de 60 días de mora y promesa incumplida hoy."
          },
          {
            "name": "Sin celular Vista 1",
            "expression": "CALCULATE(COUNTROWS(vw_promesas_incumplidas_3d), ISBLANK(vw_promesas_incumplidas_3d[telefono_celular]))",
            "formatString": "#,0",
            "displayFolder": "8. Seguimiento de promesas",
            "description": "Filas de la Vista 1 sin celular conocido (el crédito no aparece en el Reporte1)."
          },
          {
            "name": "Ejecución de las vistas",
            "expression": "IF(ISEMPTY(vw_promesas_incumplidas_3d), \"Sin datos\", FORMAT(MAX(vw_promesas_incumplidas_3d[fecha_hora_ejecucion]), \"dd/mm/yyyy hh:nn\"))",
            "formatString": "",
            "displayFolder": "8. Seguimiento de promesas",
            "description": "Fecha y hora en que se consultaron las vistas (última actualización)."
          }
        ]
      }
    ],
