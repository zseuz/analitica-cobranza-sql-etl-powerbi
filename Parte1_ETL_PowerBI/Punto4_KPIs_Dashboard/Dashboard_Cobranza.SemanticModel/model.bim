                "    Origen = Sql.Database(ServidorSQL, BaseDatos),",
                "    Tabla = Origen{[Schema=\"mart\",Item=\"resumen_ia\"]}[Data]",
                "in",
                "    Tabla"
              ]
            }
          }
        ]
      },
